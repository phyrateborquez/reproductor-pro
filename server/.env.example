# =======================================================
# ReproductorPro — Variables de Entorno
# Copia este archivo a .env y completa los valores reales
# NUNCA commitees el archivo .env al repositorio
# =======================================================

# Puerto del servidor
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Contraseña del panel de administración (REQUERIDA)
ADMIN_PASSWORD=cambia-esta-contraseña-ahora

# Secreto para firmar las cookies de sesión (REQUERIDO en producción)
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=cambia-este-secreto-ahora

# -------------------------------------------------------
# BASE DE DATOS — Turso (producción)
# Dejar en blanco en desarrollo (usará SQLite local)
# -------------------------------------------------------
# URL de tu base de datos Turso (formato: libsql://nombre-org.turso.io)
TURSO_DATABASE_URL=

# Token de autenticación de Turso (generado en el dashboard)
TURSO_AUTH_TOKEN=

# Ruta del archivo de base de datos SQLite local (solo desarrollo)
DB_PATH=./data/reproductor.db

# -------------------------------------------------------
# CORS — Orígenes permitidos (separados por coma)
# -------------------------------------------------------
ALLOWED_ORIGINS=https://www.futuroalternativo.net,https://futuroalternativo.net

# API de precios (no cambiar salvo que CoinGecko cambie su URL)
COINGECKO_URL=https://api.coingecko.com/api/v3/simple/price

# Segundos de tolerancia antes de corregir drift de sincronización
DRIFT_THRESHOLD=1

# Intervalo de broadcast a todos los clientes (milisegundos)
BROADCAST_INTERVAL=2000
